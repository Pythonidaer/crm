# Copy to .env.local and fill in values for local development.
# Vite loads .env.local automatically; it is gitignored.

# Google Maps Platform — used by scripts/enrich-google-places.js (Node, local only)
# Create a key at https://console.cloud.google.com/google/maps-apis/credentials
# Restrict by IP for local script use.
GOOGLE_MAPS_API_KEY=

# Optional: in-app Places dev stub (not used by the enrichment script)
# VITE_GOOGLE_PLACES_KEY=

# Optional: skip the login screen during local development
# VITE_DEV_AUTO_LOGIN=true
